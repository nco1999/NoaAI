# Supabase (create a project at https://supabase.com, then copy these from
# Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only, used for admin operations (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI Image API (GPT Image) - used for icon generation (raster source,
# vectorized locally into SVG - see src/lib/svg/vectorize.ts) and, later, the
# backgrounds module. Server-only, never exposed to the client.
OPENAI_API_KEY=sk-...
# Defaults to gpt-image-2 (the current GPT Image model as of writing). Only
# set this to pin/override it.
# OPENAI_IMAGE_MODEL=gpt-image-2
