# Supabase (create a project at https://supabase.com, then copy these from
# Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only, used for admin operations (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (SVG icon generation) - server-only, never exposed to the client
ANTHROPIC_API_KEY=sk-ant-...

# Image generation for the backgrounds module (server-only)
OPENAI_API_KEY=sk-...
